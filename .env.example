# Server-only AI configuration. Vercel deployments can authenticate with their
# automatic VERCEL_OIDC_TOKEN, so a manual key is mainly for local/non-Vercel use.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5-mini

# Supabase server persistence. Prefer a current Supabase secret key in deployed environments.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# A publishable key may be used server-side for insert-only RLS during local development.
SUPABASE_PUBLISHABLE_KEY=

# Browser-safe values used only by the authenticated admin dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
